{
    "name": "en-semble",
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "dev:prod": "nuxt dev --dotenv .env.prod",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "npm run lint:eslint && npm run lint:prettier",
        "lint:eslint": "eslint .",
        "lint:prettier": "prettier --check .",
        "format": "prettier --write .",
        "typecheck": "nuxt typecheck",
        "clean": "rm -rf .nuxt .output dist node_modules/.cache",
        "generate:types": "supabase gen types typescript --local > shared/types/database.types.ts",
        "test": "vitest run"
    },
    "devDependencies": {
        "@nuxt/icon": "^2.4.1",
        "@nuxtjs/i18n": "^10.5.0",
        "@nuxtjs/supabase": "^2.0.9",
        "@nuxtjs/tailwindcss": "^6.14.0",
        "@primevue/nuxt-module": "^4.5.5",
        "@tailwindcss/forms": "^0.5.7",
        "@types/node": "^26.1.2",
        "autoprefixer": "^10.4.16",
        "eslint": "8.56.0",
        "eslint-config-prettier": "9.1.0",
        "nuxt": "^4.5.1",
        "postcss": "^8.4.32",
        "prettier": "3.1.1",
        "sass": "^1.69.5",
        "supabase": "^2.110.0",
        "tailwindcss": "^3.4.0",
        "typescript": "~5.9",
        "vitest": "^4.1.10",
        "vue": "^3.5.40",
        "vue-router": "^5.2.0",
        "vue-tsc": "^3.3.8"
    },
    "dependencies": {
        "@nuxtjs/color-mode": "^4.0.1",
        "@primeuix/themes": "^2.0.3",
        "primeicons": "^7.0.0",
        "primevue": "^4.5.5",
        "tailwindcss-primeui": "^0.6.1",
        "zod": "^4.4.3"
    },
    "overrides": {
        "esbuild": "^0.28.0"
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
