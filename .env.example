# Template for .env (local Supabase stack) and .env.prod (production).
# Copy to .env and fill in — `supabase start` then `supabase status` prints the
# local URL and keys. .env is the default; .env.prod is used by `npm run dev:prod`.
NITRO_PORT=3001

# Local:      http://127.0.0.1:54321
# Production: https://<project-ref>.supabase.co
SUPABASE_URL=

# New-format keys (sb_publishable_* / sb_secret_*). The legacy anon/service
# JWTs are deprecated — use these.
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never exposed to the client; used via serverSupabaseServiceRole.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Netlify (set in the Netlify UI, not here — listed for reference)
#
# The three SUPABASE_* vars above are read at build time. Nitro also honours
# these NUXT_* overrides at function-invocation time, which is what lets a
# deploy preview point at a different Supabase project without a rebuild:
#
#   NUXT_PUBLIC_SUPABASE_URL      overrides public.supabase.url
#   NUXT_PUBLIC_SUPABASE_KEY      overrides public.supabase.key
#   NUXT_SUPABASE_SECRET_KEY      overrides the server-only secret key
#                                 (serverSupabaseServiceRole prefers
#                                 secretKey over the legacy serviceKey)
#
# Optional — pins the auth cookie name so it survives a Supabase URL change:
#   NUXT_PUBLIC_SUPABASE_COOKIE_PREFIX
# ---------------------------------------------------------------------------
